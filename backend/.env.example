# Copy to .env and fill in real values. Never commit .env itself.

# Port the API listens on (Render sets this automatically in production)
PORT=3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Secret used to sign JWTs — use a long random string
JWT_SECRET=replace-with-a-long-random-secret

# Deployed frontend origin, used for CORS
FRONTEND_URL=https://your-site.netlify.app

# development | production
NODE_ENV=development

# Groq API key powering /api/ai/recommend and /api/ai/chat
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional: lets people register as admin by entering this code on the signup
# form. Minimum 12 characters — the server refuses to start with a shorter one.
# Leave unset to disable admin self-registration entirely (CLI promotion only).
# Generate: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_SIGNUP_CODE=
